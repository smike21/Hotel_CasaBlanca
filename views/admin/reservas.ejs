<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head') %></head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { active: 'reservas' }) %>
  <main class="admin-main">
    <div class="admin-topbar"><h1>Reservas</h1></div>
    <%- include('../partials/flash') %>

    <table class="data">
      <thead><tr><th>Código</th><th>Huésped</th><th>Habitación(es)</th><th>Check-in</th><th>Check-out</th><th>Total</th><th>Estado</th></tr></thead>
      <tbody>
        <% reservas.forEach(function(r) { %>
          <tr>
            <td><%= r.codigo %></td>
            <td><%= r.nombres %> <%= r.apellidos %></td>
            <td><%= r.habitaciones || '—' %></td>
            <td><%= new Date(r.fecha_checkin).toLocaleDateString('es-PE') %></td>
            <td><%= new Date(r.fecha_checkout).toLocaleDateString('es-PE') %></td>
            <td>S/ <%= Number(r.total).toFixed(2) %></td>
            <td>
              <form action="/admin/reservas/<%= r.id %>/estado" method="POST" style="display:flex; gap:8px;">
                <select name="estado_id">
                  <% estados.forEach(function(e) { %>
                    <option value="<%= e.id %>" <%= e.id === r.estado_id ? 'selected' : '' %>><%= e.nombre %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-ghost-dark">Cambiar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
</body>
</html>
